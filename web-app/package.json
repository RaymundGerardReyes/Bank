{
  "name": "banking-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "Hardened Next.js + TypeScript + Tailwind CSS Web Frontend for Banking Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-query": "^5.66.0",
    "zustand": "^5.0.3",
    "react-hook-form": "^7.54.2",
    "zod": "^3.24.2",
    "@hookform/resolvers": "^3.10.0",
    "@simplewebauthn/browser": "^11.0.0",
    "@scalar/api-reference-react": "^0.3.17",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1",
    "lucide-react": "^0.475.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.7",
    "@tailwindcss/postcss": "^4.0.7",
    "postcss": "^8.5.2",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "prettier": "^3.5.1",
    "vitest": "^3.0.6",
    "@testing-library/react": "^16.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@playwright/test": "^1.50.1"
