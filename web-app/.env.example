# Backend Spring Boot API Base URL (Internal BFF proxy destination)
BACKEND_API_BASE_URL=http://localhost:8085/api/v1

# Next.js App Internal URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth Cookie & JWT Secret
SESSION_SECRET=super-secret-jwt-signing-key-32-chars-min!

# OpenAPI Spec Source for /developers API docs route
OPENAPI_SPEC_URL=http://localhost:8085/v3/api-docs

# Feature Flags
ENABLE_PASSKEY_AUTH=true
ENABLE_DEV_API_DOCS=true
