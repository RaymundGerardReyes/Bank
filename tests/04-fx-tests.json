{
	"info": {
		"_postman_id": "c1f2b3e0-1c4b-4b11-b0e1-4c12d45a7b8e",
		"name": "04 - FX",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 - Currency Validation",
			"item": []
		},
		{
			"name": "02 - Same Currency Regression",
			"item": [
				{
					"name": "Same Currency Transfer (PHP)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/transfers",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "transfers"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\"sourceAccountNumber\":\"{{phpSourceAccount}}\",\"destinationAccountNumber\":\"{{phpDestAccount}}\",\"amount\":100.00,\"description\":\"Test Same Currency\"}"
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "03 - Cross Currency Safety",
			"item": [
				{
					"name": "USD to PHP (Blocked by Accounting Gate)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/transfers",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "transfers"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\"sourceAccountNumber\":\"{{usdSourceAccount}}\",\"destinationAccountNumber\":\"{{phpDestAccount}}\",\"amount\":10.00,\"description\":\"Test Cross Currency\"}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 409 Conflict (Accounting Gate)\", function () {",
									"    pm.response.to.have.status(409);",
									"});",
									"pm.test(\"Error message indicates cross currency disabled\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"cross-currency ledger posting is disabled\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"response": []
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "phpSourceAccount", "value": "" },
		{ "key": "phpDestAccount", "value": "" },
		{ "key": "usdSourceAccount", "value": "" }
	]
}
