{
  "info": {
    "name": "Banking Internal Transfer Comprehensive Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Login (Get Session Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login Successful (200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    const token = jsonData.token || (jsonData.data && jsonData.data.token);",
              "    pm.expect(token).to.be.a('string');",
              "    pm.environment.set('sessionToken', token);",
              "    console.log('Session token saved successfully to environment!');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "01.5 - Auto-Configure Environment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Accounts Retrieved (200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Auto-Configure Account Variables', function () {",
              "    const jsonData = pm.response.json();",
              "    const accounts = jsonData.data.content || jsonData.data;",
              "    pm.expect(accounts).to.be.an('array').that.is.not.empty;",
              "    ",
              "    // Automatically set the source account to the logged-in user's first account",
              "    if (accounts.length > 0 && !pm.environment.get('sourceAccountNumber')) {",
              "        pm.environment.set('sourceAccountNumber', accounts[0].accountNumber);",
              "    }",
              "    ",
              "    // Set destination account dynamically from second account if available, or fallback to environment",
              "    if (accounts.length > 1 && !pm.environment.get('destinationAccountNumber')) {",
              "        pm.environment.set('destinationAccountNumber', accounts[1].accountNumber);",
              "    }",
              "    ",
              "    console.log('Successfully configured account variables dynamically from environment payload!');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        }
      }
    },
    {
      "name": "02 - Golden Path Immediate Transfer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('goldenIdemKey', 'idem-int-' + Date.now());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Transfer Succeeds (200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Status is PENDING or COMPLETED', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.status).to.be.oneOf(['PENDING', 'COMPLETED']);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"sourceAccountNumber\": \"{{sourceAccountNumber}}\",\n    \"destinationAccountNumber\": \"{{destinationAccountNumber}}\",\n    \"amount\": 50.00,\n    \"description\": \"Standard Transfer\",\n    \"idempotencyKey\": \"{{goldenIdemKey}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/transfers/internal",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transfers",
            "internal"
          ]
        }
      }
    },
