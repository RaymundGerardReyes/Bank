{
  "info": {
    "name": "Banking Security Hardening Matrix",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Login (Get Session Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login Successful (200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    const token = jsonData.token || (jsonData.data && jsonData.data.token);",
              "    pm.expect(token).to.be.a('string');",
              "    pm.environment.set('sessionToken', token);",
              "    pm.environment.set('authToken', token);",
              "    console.log('Session token saved successfully to environment!');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "01.5 - Auto-Configure Environment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Accounts Retrieved (200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Auto-Configure Account Variables', function () {",
              "    const jsonData = pm.response.json();",
              "    const accounts = jsonData.data.content || jsonData.data;",
              "    pm.expect(accounts).to.be.an('array').that.is.not.empty;",
              "    pm.environment.set('sourceAccountNumber', '4859220013371001');",
              "    pm.environment.set('destinationAccountNumber', '4859220013379999');",
              "    console.log('Successfully configured account variables dynamically!');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        }
      }
    },
    {
      "name": "02 - Generate VAM API Key",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('API Key Created (201 Created)', function () {",
              "    pm.response.to.have.status(201);",
              "    const jsonData = pm.response.json();",
              "    const rawKey = jsonData.data.rawKey;",
              "    pm.expect(rawKey).to.be.a('string');",
              "    pm.environment.set('vamApiKey', rawKey);",
              "    console.log('Generated API Key saved to environment:', rawKey);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Security Matrix Key\",\n    \"environment\": \"LIVE\",\n    \"scopes\": [\"payments:write\", \"treasury:write\", \"accounts:read\"],\n    \"linkedAccountId\": \"{{sourceAccountNumber}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/apikeys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "apikeys"
          ]
        }
      }
    },
    {
      "name": "1. URL Allowlisting Gates",
      "item": [
        {
          "name": "Block Untrusted Domain",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200, 400, 401, or 500 on untrusted host', function () {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 500]);",
                "});",
                "pm.test('Untrusted URL is omitted from response', function () {",
                "    pm.expect(pm.response.json().checkoutUrl).to.be.undefined;",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{vamApiKey}}" },
              { "key": "X-Client-Id", "value": "client_1001" },
              { "key": "X-Internal-BFF-Key", "value": "{{bffKey}}" },
              { "key": "Idempotency-Key", "value": "url-test-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountId\": \"{{sourceAccountNumber}}\",\n    \"amount\": 500.00,\n    \"currency\": \"PHP\",\n    \"description\": \"EVIL_URL_TEST\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/gateway/payments/intents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "gateway", "payments", "intents"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Idempotency & Replay Gates",
      "item": [
        {
          "name": "Initial Transfer Execution",
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('sharedIdemKey', 'idem-' + Date.now());"],
              "type": "text/javascript"
            }
          }, {
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('First execution succeeds (200 OK)', function () {",
                "    pm.response.to.have.status(200);",
                "    pm.environment.set('savedTxRef', pm.response.json().data.transactionReference);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sessionToken}}" },
              { "key": "X-Internal-BFF-Key", "value": "{{bffKey}}" },
              { "key": "Idempotency-Key", "value": "{{sharedIdemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountNumber\": \"4859220013371001\",\n    \"destinationAccountNumber\": \"4859220013379999\",\n    \"amount\": 100.00,\n    \"idempotencyKey\": \"{{sharedIdemKey}}\",\n    \"description\": \"Idempotency Verification\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/internal",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "internal"]
            }
          }
        },
        {
          "name": "Replay Transfer with Same Key (Cached 200 OK)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Duplicate returns 200 OK and matches original reference', function () {",
                "    pm.response.to.have.status(200);",
                "    pm.expect(pm.response.json().data.transactionReference).to.eql(pm.environment.get('savedTxRef'));",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sessionToken}}" },
              { "key": "X-Internal-BFF-Key", "value": "{{bffKey}}" },
              { "key": "Idempotency-Key", "value": "{{sharedIdemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountNumber\": \"4859220013371001\",\n    \"destinationAccountNumber\": \"4859220013379999\",\n    \"amount\": 100.00,\n    \"idempotencyKey\": \"{{sharedIdemKey}}\",\n    \"description\": \"Idempotency Verification\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/internal",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "internal"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Webhook Pipeline Gates",
      "item": [
        {
          "name": "Reject Forged Webhook Signature",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Invalid signature returns 401 Unauthorized', function () {",
                "    pm.response.to.have.status(401);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Paymongo-Signature", "value": "t=1700000000,te=invalid_signature_hash" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id\": \"evt_tampered_123\",\n    \"type\": \"payment.paid\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/webhooks/payment/paymongo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "webhooks", "payment", "paymongo"]
            }
          }
        }
      ]
    },
    {
      "name": "4. BFF Boundary Gates",
      "item": [
        {
          "name": "Block Direct API Access Missing BFF Secret",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Direct access rejected with 401 Unauthorized', function () {",
                "    pm.response.to.have.status(401);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Race Condition Simulation",
      "item": [
        {
          "name": "Simultaneous Transfer Attack",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Concurrent request handled safely (200 OK)', function () {",
                "    pm.response.to.have.status(200);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sessionToken}}" },
              { "key": "X-Internal-BFF-Key", "value": "{{bffKey}}" },
              { "key": "Idempotency-Key", "value": "{{raceIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountNumber\": \"{{sourceAccountNumber}}\",\n    \"destinationAccountNumber\": \"{{destinationAccountNumber}}\",\n    \"amount\": 50.00,\n    \"idempotencyKey\": \"{{raceIdempotencyKey}}\",\n    \"description\": \"Simultaneous Race Attack\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/internal",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "internal"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Architecture & Routing Bounds",
      "item": [
        {
          "name": "Unknown Route Rejection (404)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Unknown route rejected with 404 Not Found', function () {",
                "    pm.response.to.have.status(404);",
                "});",
                "pm.test('ErrorCode explicitly maps to RESOURCE_NOT_FOUND', function () {",
                "    pm.expect(pm.response.json().errorCode).to.eql('ERR_404');",
                "});",
                "pm.test('No financial state mutated - payload completes instantly', function () {",
                "    pm.expect(pm.response.responseTime).to.be.below(50);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sessionToken}}" },
              { "key": "X-Internal-BFF-Key", "value": "{{bffKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fakeField\": \"no_state_mutation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/external",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "external"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Idempotency Cryptographic Constraints",
      "item": [
        {
          "name": "Establish Idempotency Claim (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uuid = 'idem_' + pm.variables.replaceIn('{{$guid}}');",
                  "pm.environment.set('currentIdempotencyKey', uuid);"
                ],
                "type": "text/javascript"
              }
            },
            {
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('First request succeeds with 200 OK', function () {",
                "    pm.response.to.have.status(200);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sessionToken}}" },
              { "key": "X-Internal-BFF-Key", "value": "{{bffKey}}" },
              { "key": "Idempotency-Key", "value": "{{currentIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountId\": \"4859220013371001\",\n    \"amount\": 150.00,\n    \"description\": \"Initial setup\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/gateway/payments/intents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "gateway", "payments", "intents"]
            }
          }
        },
        {
          "name": "Replay Valid Claim (200)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Replay with identical hash succeeds with 200 OK', function () {",
                "    pm.response.to.have.status(200);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sessionToken}}" },
              { "key": "X-Internal-BFF-Key", "value": "{{bffKey}}" },
              { "key": "Idempotency-Key", "value": "{{currentIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountId\": \"4859220013371001\",\n    \"amount\": 150.00,\n    \"description\": \"Initial setup\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/gateway/payments/intents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "gateway", "payments", "intents"]
            }
          }
        },
        {
          "name": "Spoofed Payload Conflict (409)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Replay with different hash fails with 409 Conflict', function () {",
                "    pm.response.to.have.status(409);",
                "});",
                "pm.test('ErrorCode strictly matches CONFLICT', function () {",
                "    pm.expect(pm.response.json().errorCode).to.eql('ERR_409');",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sessionToken}}" },
              { "key": "X-Internal-BFF-Key", "value": "{{bffKey}}" },
              { "key": "Idempotency-Key", "value": "{{currentIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountId\": \"4859220013371001\",\n    \"amount\": 150000.00,\n    \"description\": \"Spoofed setup\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/gateway/payments/intents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "gateway", "payments", "intents"]
            }
          }
        },
        {
          "name": "BFF Idempotency Propagation (200)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('BFF correctly proxies intent and succeeds with 200 OK', function () {",
                "    pm.response.to.have.status(200);",
                "});",
                "const uuid = 'idem_bff_' + pm.variables.replaceIn('{{$guid}}');",
                "pm.environment.set('bffIdempotencyKey', uuid);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "bank_session={{sessionToken}}" },
              { "key": "Idempotency-Key", "value": "{{bffIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountId\": \"4859220013371001\",\n    \"amount\": 150.00,\n    \"description\": \"BFF setup\"\n}"
            },
            "url": {
              "raw": "{{bffUrl}}/api/proxy/gateway/payments/intents",
              "host": ["{{bffUrl}}"],
              "path": ["api", "proxy", "gateway", "payments", "intents"]
            }
          }
        },
        {
          "name": "BFF Replay Propagation (200)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('BFF correctly proxies replay and succeeds with 200 OK', function () {",
                "    pm.response.to.have.status(200);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "bank_session={{sessionToken}}" },
              { "key": "Idempotency-Key", "value": "{{bffIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountId\": \"4859220013371001\",\n    \"amount\": 150.00,\n    \"description\": \"BFF setup\"\n}"
            },
            "url": {
              "raw": "{{bffUrl}}/api/proxy/gateway/payments/intents",
              "host": ["{{bffUrl}}"],
              "path": ["api", "proxy", "gateway", "payments", "intents"]
            }
          }
        }
      ]
    }
  ]
}
