              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Contains LIMIT_EXCEEDED error code', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.errorCode).to.be.oneOf(['LIMIT_EXCEEDED', 'TRANSFER_VELOCITY_EXCEEDED', 'ERR_BANK_008', 'ERR_BANK_006']);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
