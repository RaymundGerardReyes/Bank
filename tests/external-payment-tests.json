        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Duplicate Blocked (409 Conflict)', function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"sourceAccountNumber\": \"{{sourceAccountNumber}}\",\n    \"destinationAccountNumber\": \"EXT-999-555\",\n    \"routingNumber\": \"SWIFT123\",\n    \"recipientName\": \"Global Corp\",\n    \"amount\": 1000.00,\n    \"railName\": \"SWIFT\",\n    \"idempotencyKey\": \"{{externalIdemKey}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/transfers/external",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transfers",
            "external"
          ]
        }
      }
    },
    {
      "name": "05 - Insufficient Funds Post-Sweep",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('insufficientIdemKey', 'idem-ext-nsf-' + Date.now());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Transaction Rejected (400 Bad Request)', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Contains INSUFFICIENT_FUNDS or LIMIT_EXCEEDED error code', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.errorCode).to.be.oneOf(['INSUFFICIENT_FUNDS', 'LIMIT_EXCEEDED', 'ERR_BANK_001', 'ERR_BANK_008']);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"sourceAccountNumber\": \"{{sourceAccountNumber}}\",\n    \"destinationAccountNumber\": \"EXT-999-555\",\n    \"routingNumber\": \"SWIFT123\",\n    \"recipientName\": \"Global Corp\",\n    \"amount\": 99999999.00,\n    \"railName\": \"SWIFT\",\n    \"idempotencyKey\": \"{{insufficientIdemKey}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/transfers/external",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transfers",
            "external"
          ]
        }
      }
    },
