    {
      "name": "08 - Fraud Screening Block",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('fraudIdemKey', 'idem-ext-fraud-' + Date.now());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Transaction Rejected (400 or 403)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 403]);",
              "});",
              "",
              "pm.test('Contains FRAUD_DETECTED error code', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.errorCode).to.be.oneOf(['ERR_BANK_004', 'FRAUD_DETECTED']);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"sourceAccountNumber\": \"{{sourceAccountNumber}}\",\n    \"destinationAccountNumber\": \"EXT-SUSPICIOUS-999\",\n    \"routingNumber\": \"SWIFT123\",\n    \"recipientName\": \"Sanctioned Entity\",\n    \"amount\": 1000.00,\n    \"railName\": \"SWIFT\",\n    \"idempotencyKey\": \"{{fraudIdemKey}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/transfers/external",
