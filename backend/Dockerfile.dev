# syntax=docker/dockerfile:1

# ============================================================
# DEV-ONLY RUNTIME STAGE
# The JAR is pre-built on the HOST via Gradle (native JVM).
# This image simply receives the pre-built JAR via a volume
# mount (compose.dev.yaml) and runs it — no compilation inside Docker.
# This cuts the backend Docker build time from 10+ min to ~10s.
# ============================================================
FROM eclipse-temurin:21-jre-alpine AS runtime

WORKDIR /app

# Create a non-root user
RUN addgroup -S spring && adduser -S spring -G spring

# The JAR is injected at runtime via:
#   volumes:
#     - ../../backend/build/libs:/app/libs:ro
# So we create a placeholder script that finds the JAR at startup
RUN echo '#!/bin/sh' > /app/entrypoint.sh && \
    echo 'exec java ${JAVA_OPTS} -jar /app/libs/*.jar "$@"' >> /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh && \
    chown -R spring:spring /app

USER spring:spring

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=5 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/actuator/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]

