{
  "name": "expobankingapp",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "npx expo start",
    "go": "node scripts/start-lan.mjs start --lan --go",
    "start:lan": "node scripts/start-lan.mjs start --lan",
    "tunnel": "npx expo start --tunnel",
    "tunnel:go": "npx expo start --tunnel --go",
    "expo:ios": "npx expo start --tunnel --go",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "build": "npx expo export -p android -p ios --clear",
    "build:android": "npx expo export -p android --clear",
    "build:ios": "npx expo export -p ios --clear",
    "build:all": "npx expo export -p all --clear",
    "env:check": "node ../scripts/check-env.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@notifee/react-native": "7.8.2",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@reduxjs/toolkit": "^2.12.0",
    "@stomp/stompjs": "^7.0.0",
    "axios": "^1.18.1",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.28",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-local-authentication": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-error-boundary": "^6.1.2",
    "react-native": "0.86.3",
    "react-native-nitro-inspire-face": "^0.3.6",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vision-camera": "^4.0.0",
    "react-native-worklets-core": "^1.6.3",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-arrow-functions": "^7.29.7",
    "@babel/plugin-transform-shorthand-properties": "^7.29.7",
    "@babel/plugin-transform-template-literals": "^7.29.7",
    "@dotenvx/dotenvx": "^1.0.0",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@notifee/react-native"
        ]
      }
    }
  }
}
