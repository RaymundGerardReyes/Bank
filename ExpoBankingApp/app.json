{
  "expo": {
    "name": "ExpoBankingApp",
    "slug": "ExpoBankingApp",
    "scheme": "novabank",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow NovaBank to access your camera for secure biometric authentication.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.rayger.ExpoBankingApp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rayger.ExpoBankingApp",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "./plugins/withNotifeeMaven",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Allow NovaBank to access your camera for secure biometric authentication.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "9760bd56-046a-4554-8b87-694da2264c61"
      }
    }
  }
}
