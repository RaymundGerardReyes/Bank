# ==========================================
# 🚀 Bank Monorepo Global .gitignore
# ==========================================

# 1. Environment & Secrets  (centralized via dotenvx — root .env only)
# ── Block the one real .env and any accidental per-app copies ──
.env
.env.local
.env.staging
.env.production
.env.development
.env.test
.env.development.local
.env.test.local
.env.production.local
# ── Always allow example/pointer files ──
!.env.example
!**/.env.example
*.pem
*.keystore
local.properties

# 2. IDE & OS Files
.idea/
.vscode/
*.iws
*.iml
*.ipr
.settings/
.project
.classpath
.factorypath
.sts4-cache
.apt_generated
.springBeans
.DS_Store
Thumbs.db

# 3. Node & JavaScript ecosystem (Frontend & Mobile)
node_modules/
npm-debug.log
yarn-error.log
yarn-debug.log
.pnp
.pnp.js
coverage/

# 4. Next.js (Web App)
web-app/.next/
web-app/out/
web-app/build/
web-app/.swc/
.next/
out/
build/

# 5. Expo & React Native (Mobile App)
.expo/
.expo-shared/
.watchmanconfig
ExpoBankingApp/web-build/
ExpoBankingApp/dist/
android/app/build/
android/build/
ios/Pods/
ios/build/
*.xcworkspace/xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.apk
*.aab

# 6. Spring Boot & Java (Backend)
backend/build/
backend/out/
backend/target/
backend/.gradle/
backend/bin/
build/
target/
.gradle/
!**/src/main/**/build/
!**/src/test/**/build/
*.class
*.jar
*.war
*.ear
*.nar
*.log

# 7. Other Cache & Logs
logs/
*.log
.eslintcache
.stylelintcache
